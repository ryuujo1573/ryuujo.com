---
import HangzhouRouteMap from '../../components/trip/HangzhouRouteMap.astro';
import { mapSearch, tripDays } from '../../lib/hangzhou-trip';
import mapScript from '../../scripts/hangzhou-trip-map.js?url';
import '../../styles/hangzhou-trip.css';

const title = '杭州三日慢游';
const description = '11 月 24–26 日，从香樟公寓出发，逛断桥和西湖北岸、在庆春朴门吃素餐后游灵隐寺，再高铁往返苏州古城。';
const canonical = new URL('/trip/hangzhou', Astro.site);
const assets = '/trip/hangzhou';
const cover = assets + '/media/west-lake.webp';
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={description}>
  <meta name="theme-color" content="#f7f6f1">
  <title>{title}</title>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={new URL(cover, Astro.site)}>
  <link rel="stylesheet" href={assets + '/vendor/leaflet.css'}>
  <script is:inline defer src={assets + '/vendor/leaflet.js'}></script>
  <script is:inline defer src={mapScript}></script>
</head>
<body id="top">
  <a class="skip" href="#itinerary">跳到行程</a>
  <header class="site-header">
    <div class="frame header-inner">
      <a class="brand" href="#top">杭州慢游</a>
      <nav aria-label="页面导航">
        <a href="#routes">路线地图</a>
        <a href="#itinerary">三日行程</a>
        <a href="#flex">机动备选</a>
      </nav>
    </div>
  </header>
  <main class="frame">
    <section class="hero" aria-labelledby="title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="dot"></span> 从香樟公寓出发</p>
        <h1 id="title">杭州三日<br><em>慢慢游</em></h1>
        <p class="hero-description">11 月 24–26 日，带爸妈逛西湖北岸、吃素餐游灵隐，再去苏州看园林、听评弹。</p>
        <a class="primary" href="#itinerary">查看三日行程</a>
      </div>
      <figure class="hero-photo">
        <img src={cover} alt="杭州西湖湖面、雷峰塔和远处的山" width="1440" height="810" fetchpriority="high">
        <figcaption>杭州西湖 · 雷峰塔</figcaption>
      </figure>
    </section>

    <HangzhouRouteMap />

    <section class="itinerary-section" id="itinerary" aria-labelledby="itinerary-title">
      <div class="section-heading">
        <div>
          <h2 id="itinerary-title">三日行程</h2>
          <p>2026 年 11 月 24–26 日。出门前查看当天的预约与车票。</p>
        </div>
      </div>
      {tripDays.map((day) => (
        <article class:list={['trip-card', day.id]} id={'day-' + day.id}>
          <header class="card-head">
            <div>
              <p class="card-kicker"><time datetime={day.date}>{day.day}</time></p>
              <h3>{day.title}</h3>
              <p class="card-intro">{day.intro}</p>
            </div>
            <a class="navigation" href={day.navigation.url} target="_blank" rel="noopener">{day.navigation.label}</a>
          </header>
          <div class="card-content">
            <ol class="timeline">
              {day.timeline.map((stop) => (
                <li>
                  <span class="time">{stop.time}</span>
                  <div>
                    <strong>{stop.title}</strong>
                    <p>{stop.detail}</p>
                  </div>
                </li>
              ))}
            </ol>
            <div class="side-note">
              <h4>{day.note.title}</h4>
              <p>{day.note.detail}</p>
              {day.note.links.map((link) => (
                link.url.startsWith('tel:') ? (
                  <a href={link.url}>{link.label}</a>
                ) : (
                  <a href={link.url} target="_blank" rel="noopener">{link.label}</a>
                )
              ))}
            </div>
          </div>
        </article>
      ))}
    </section>

    <section class="flex-section" id="flex" aria-labelledby="flex-title">
      <div class="section-heading"><div><h2 id="flex-title">机动备选</h2><p>按当天的天气、预约和爸妈的体力调整。</p></div></div>
      <div class="flex-grid">
        <article>
          <span>苏博本馆没约到</span>
          <h3>苏州民俗博物馆</h3>
          <p>平江路附近的潘儒巷 32 号，免预约排队入馆。也可以把时间留给河边喝茶。</p>
          <a href={mapSearch('苏州民俗博物馆', '苏州')} target="_blank" rel="noopener">高德找民俗馆</a>
          <a href="https://www.suzhou.gov.cn/szsrmzf/mszx/202609/2d1a50ec4496485d9f5c332de585dfdc.shtml" target="_blank" rel="noopener">入馆说明</a>
        </article>
        <article id="day-xixi">
          <span>杭州有空再去</span>
          <h3>西溪湿地坐船</h3>
          <p>打车到周家村游客中心，买票前问清当天回到同一码头的班次。</p>
          <a href={mapSearch('西溪湿地周家村游客中心')} target="_blank" rel="noopener">高德找周家村</a>
        </article>
        <article id="day-canal">
          <span>杭州有空再去</span>
          <h3>拱宸桥西岸</h3>
          <p>打车到小河路 334 号，看一间工美馆展厅，再到西桥头坐坐。工美馆周二闭馆。</p>
          <a href="https://www.amap.com/place/B023B0I02U" target="_blank" rel="noopener">高德找工美馆</a>
        </article>
      </div>
    </section>
  </main>
  <footer class="frame site-footer">
    <details>
      <summary>交通、场馆和餐厅资料</summary>
      <div class="references">
        <a href="https://www.lingyinsi.org/detail_57_19456.html" target="_blank" rel="noopener">灵隐交通通告</a>
        <a href="https://appassets.mvtdev.com/map/30/l/5015/644166.pdf" target="_blank" rel="noopener">西湖北岸公交 7 路</a>
        <a href="https://amap-pc-ssr.amap.com/ssr/subway/hangzhou-3301" target="_blank" rel="noopener">杭州地铁线路图</a>
        <a href="https://gs.ctrip.com/html5/you/foods/fooddetail/458/5123677.html" target="_blank" rel="noopener">松鹤楼观前街店</a>
        <a href="https://gs.ctrip.com/html5/you/foods/Suzhou11/5133429.html" target="_blank" rel="noopener">桃花源记平江 1 店</a>
        <a href="https://www.gusu.gov.cn/gsq/zwyw/202302/d5f754d029f84e96822cbd72384458fc.shtml" target="_blank" rel="noopener">平江路与评弹</a>
      </div>
    </details>
    <p class="credit">西湖照片 <a href="https://commons.wikimedia.org/wiki/File:Westlake%26leifengpagoda202012.jpg" target="_blank" rel="noopener">Charlie fong</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA 4.0</a> · 缩放裁切</p>
  </footer>
</body>
</html>
