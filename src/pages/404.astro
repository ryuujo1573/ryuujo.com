---
import Footer from '../components/Footer.astro';
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="404 — ryuujo" description="Page not found" />
	</head>
	<body>
		<main>
			<h1>404</h1>
			<p class="hint">The page you are looking for does not exist.</p>
			<p><a href="/">← Back to home</a></p>
		</main>
		<Footer />
	</body>
</html>

<style>
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		background: #fff;
	}
	main {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 3em 1em;
	}
	h1 {
		margin: 0;
		font-size: 3.5em;
	}
	.hint {
		color: rgb(var(--gray));
		margin-top: 0.4em;
	}
</style>
