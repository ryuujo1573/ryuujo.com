---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} ryuujo</p>
	<p class="icp">
		<a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">
			浙ICP备2026075780号
		</a>
	</p>
</footer>

<style>
	footer {
		padding: 1.5em 1em 2em;
		text-align: center;
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
	footer p {
		margin: 0.2em 0;
	}
	.icp a {
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.icp a:hover {
		color: rgb(var(--gray-dark));
		text-decoration: underline;
	}
</style>
