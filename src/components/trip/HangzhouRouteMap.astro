---
import { tripDays } from '../../lib/hangzhou-trip';
---

<section class="map-section" id="routes" aria-labelledby="route-title">
  <div class="section-heading">
    <div>
      <h2 id="route-title">路线地图</h2>
      <p>选一天看走法，点地图上的地点可以打开高德导航。</p>
    </div>
    <div class="map-filters" role="group" aria-label="筛选地图路线">
      <button type="button" data-route="all" aria-pressed="true" disabled>杭州总览</button>
      {tripDays.map((day) => (
        <button type="button" data-route={day.id} aria-pressed="false" disabled>{day.label}</button>
      ))}
    </div>
  </div>
  <div class="route-layout">
    <aside class="route-guide" aria-label="路线和交通">
      <div class="origin">
        <span class="origin-icon" aria-hidden="true"></span>
        <div><strong>住宿起点</strong><a href="https://www.amap.com/place/B023B026C6" target="_blank" rel="noopener">香樟公寓 · 文三西路 360 号</a></div>
      </div>
      <div class="guide-days">
        {tripDays.map((day, index) => (
          <div class:list={['guide-day', day.id]} data-route-row={day.id}>
            <button class="guide-select" type="button" data-route={day.id} aria-pressed="false" disabled>
              <span class="day-id" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span><strong>{day.title}</strong><small>{day.transport}</small></span>
            </button>
            <a href={'#day-' + day.id} class="guide-link" aria-label={'查看' + day.title + '时间表'}>查看时间表</a>
          </div>
        ))}
      </div>
    </aside>
    <div class="map-panel">
      <div id="trip-map" aria-label="杭州和苏州路线交互地图" role="region">
        <p class="map-fallback">地图未载入时，可使用各天行程中的高德入口。</p>
      </div>
      <div class="map-caption">
        <div class="legend"><span><i></i>打车</span><span><i class="dash"></i>公交或接驳</span><span><i class="walk"></i>步行</span></div>
        <span id="map-caption-text">连线仅供示意，实际走法看导航。</span>
      </div>
      <p id="map-status" class="visually-hidden" aria-live="polite"></p>
    </div>
  </div>
</section>
